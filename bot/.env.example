# Opcional: copie para config/.env na raiz do repositório (ou aponte ORB_BOT_ENV_FILE)
# Sem este arquivo o bot roda em modo simulado com os valores padrão abaixo.

# sim = corretora simulada local + dados Yahoo (sem conta, sem chave)
# alpaca = conta paper Alpaca (a disponibilidade varia por país)
BROKER=sim
SIM_STARTING_CASH=10000
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMD,META,GOOGL,AMZN
BOT_ENABLED=true
NOTIFICATIONS_ENABLED=true

# Só para BROKER=alpaca
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# DATA_FEED=iex

# Contato exigido pela política de acesso da SEC para o journal ler os 8-K das ações operadas.
# Formato: "Nome email@exemplo.com". Sem isso o journal usa só as manchetes do Yahoo.
# SEC_USER_AGENT=
